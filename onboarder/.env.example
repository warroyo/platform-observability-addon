# Settings for the pre-release gate. Copy to .env and fill in:
#
#   cp .env.example .env && chmod 600 .env
#
# Sourced as bash by the scripts in test/. Anything already exported in your
# shell wins over this file, so a one-off run can override a value:
#
#   DEV_VERSION=0.1.0-rc2 make dev-release
#
# The loop:
#
#   make dev-release
#   make install-supervisor-service
#   make verify-supervisor

# --- what is being released ---------------------------------------------
DEV_VERSION=0.1.0-rc1

# --- the Supervisor ------------------------------------------------------
# Kubeconfig for the Supervisor, as an administrator. Lets the install wait
# for the Deployment to roll, and verify-supervisor read everything.
KUBECONFIG="$HOME/.kube/config"

# A labelled cluster that is already onboarded, which the service must adopt
# without issuing a new secret: <namespace>/<cluster>.
ADOPT_CLUSTER=my-namespace/my-cluster

# Optional, and it changes things: an unlabelled cluster verify-supervisor
# labels to onboard, then unlabels to offboard. It gets the addon installed
# and removed, and an OAuth client created and deleted in Ops. Leave unset to
# skip that step.
#ONBOARD_CLUSTER=my-namespace/my-test-cluster

# --- vCenter, for the install step -----------------------------------------
VC_HOST=vc01.example.lab
VC_USER=administrator@vsphere.local
# Spooled to a 0600 file for the run, never on a command line.
VC_PASSWORD=
#VC_PASSWORD_FILE="$HOME/.vc_pw"
# Cluster id (e.g. domain-c9). Auto-discovered if there is only one.
#VC_CLUSTER=

# --- VCF Operations, the service's values on a first install ---------------
OPS_URL=https://ops.example.com
OPS_USERNAME=platform-observability-onboard
# What scripts/ops-account.sh create writes.
OPS_PASSWORD_FILE="$HOME/.config/vcf-ops/onboard.password"
#OPS_INSECURE=true
# Ship the AddonInstall that serves every namespace. Turn off where clusters
# already have an AddonInstall in their own namespace: two would match the
# same cluster.
ADDON_INSTALL=true
# Register the addon's helm repository. Turn off where it is already
# registered (install/addonrepository.yaml): two repositories would both
# create the same Addon.
ADDON_REPOSITORY=true
# An upgrade keeps the installed config. true: derive it from this file again.
#RESET_VALUES=true
